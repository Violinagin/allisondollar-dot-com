---
layout: layout.njk
title: Projects
hideNavTitle: true
---

<section class="hero">
  <h1>Allison Dollar</h1>
  <p class="tagline">Video · Art · Apps · Music</p>
</section>

<section class="worlds">
  <h2>Explore</h2>
  <div class="world-grid">
    <a href="https://portfolio.allisondollar.com" class="world-card">Video →</a>
    <a href="/art/" class="world-card">Art →</a>
    <a href="/apps/" class="world-card">Apps →</a>
    <a href="/journal/" class="world-card">Journal →</a>
  </div>
</section>

<section class="upcoming-classes">
  <h2>Upcoming Classes</h2>
  <div id="classes-list" class="class-preview-list">
    <div class="loading">Loading schedule…</div>
  </div>
  <div class="view-all-link">
    <a href="/calendar/">View full schedule →</a>
  </div>
</section>

<script>
(async () => {
  const SUPABASE_URL = '{{ supabaseUrl }}';
  const SUPABASE_KEY = '{{ supabaseKey }}';
  const today = new Date().toISOString();

  const res = await fetch(
    `${SUPABASE_URL}/rest/v1/teaching_classes?select=*&show_on_calendar=eq.true&start_time=gte.${today}&order=start_time.asc&limit=3`,
    { headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` } }
  );

  const classes = await res.json();
  const list    = document.getElementById('classes-list');

  if (!Array.isArray(classes) || classes.length === 0) {
    list.innerHTML = '<p class="no-entries">No upcoming classes scheduled.</p>';
    return;
  }

  list.innerHTML = classes.map(c => {
    const date = new Date(c.start_time).toLocaleDateString('en-US', {
      weekday: 'short', month: 'short', day: 'numeric',
      hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles'
    });
    return `
      <div class="class-preview-item">
        ${c.painting_image_url
          ? `<img src="${c.painting_image_url}" alt="${c.class_name}" class="class-preview-thumb">`
          : '<div class="class-preview-thumb class-preview-thumb--empty"></div>'}
        <div class="class-preview-meta">
          <span class="class-preview-name">${c.class_name}</span>
          <span class="class-preview-location">${c.location}</span>
        </div>
        <time class="class-preview-time">${date}</time>
        ${c.booking_url ? `<a href="${c.booking_url}" class="read-more" target="_blank" rel="noopener">Book →</a>` : ''}
      </div>`;
  }).join('');
})();
</script>

<section class="latest-journal">
  <h2>Latest from the blog</h2>
  
 {% set latestEntries = journalEntries.slice(0, 3) %}
  <div class="journal-previews">
    {% for entry in latestEntries %}
    <article class="preview-card">
      {% if entry.cover_image %}
      <div class="preview-image">
        <img src="{{ entry.cover_image }}" alt="">
      </div>
      {% endif %}
      <div class="preview-content">
        <h3><a href="/journal/{{ entry.slug }}/">{{ entry.title }}</a></h3>
        <time datetime="{{ entry.created_at }}">{{ entry.created_at | readableDate }}</time>
        <p>{{ entry.body | truncate(120) }}</p>
        <a href="/journal/{{ entry.slug }}/" class="read-more">Read more →</a>
      </div>
    </article>
    {% else %}
    <p class="no-entries">Journal coming soon...</p>
    {% endfor %}
  </div>
  
  <div class="view-all-link">
    <a href="/journal/">View all journal entries →</a>
  </div>
</section>