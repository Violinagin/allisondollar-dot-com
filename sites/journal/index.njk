---
layout: layout.njk
title: Journal
---

<div class="journal-header">
  <h1>Journal</h1>
  <p>What I'm making, thinking about, and learning.</p>
</div>

<div id="journal-container" class="journal-grid">
  <div class="loading">Loading entries...</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
// Fetch entries directly from Supabase
async function loadJournal() {
  const SUPABASE_URL = '{{ env.NEXT_PUBLIC_SUPABASE_URL }}';
  const SUPABASE_KEY = '{{ env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY }}';
  
  const response = await fetch(`${SUPABASE_URL}/rest/v1/journal_entries?select=*&published=eq.true&order=date.desc`, {
    headers: {
      'apikey': SUPABASE_KEY,
      'Authorization': `Bearer ${SUPABASE_KEY}`
    }
  });
  
  const entries = await response.json();
  const container = document.getElementById('journal-container');
  
  if (entries.length === 0) {
    container.innerHTML = '<p class="no-entries">No journal entries yet. Check back soon!</p>';
    return;
  }
  
  container.innerHTML = entries.map(entry => `
    <article class="journal-card">
      ${entry.cover_image ? `
        <div class="journal-cover">
          <img src="${entry.cover_image}" alt="${entry.title}">
        </div>
      ` : ''}
      <div class="journal-content">
        <h2><a href="/journal/${entry.slug}/">${escapeHtml(entry.title)}</a></h2>
        <time datetime="${entry.date}">${new Date(entry.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <div class="journal-excerpt">${marked.parse(entry.body.substring(0, 300) + (entry.body.length > 300 ? '...' : ''))}</div>
        ${entry.tags && entry.tags.length ? `
          <div class="journal-tags">
            ${entry.tags.map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join('')}
          </div>
        ` : ''}
        <a href="/journal/${entry.slug}/" class="read-more">Read more →</a>
      </div>
    </article>
  `).join('');
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/[&<>]/g, function(m) {
    if (m === '&') return '&amp;';
    if (m === '<') return '&lt;';
    if (m === '>') return '&gt;';
    return m;
  });
}

loadJournal();
</script>