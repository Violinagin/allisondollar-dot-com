---
layout: layout.njk
title: Journal Admin
---

{% if secret == env.JOURNAL_SECRET %}
<style>
  .admin-form {
    max-width: 800px;
    margin: 2rem auto;
    padding: 2rem;
    background: var(--gray);
    border-radius: 12px;
  }
  .admin-form h1 {
    margin-bottom: 2rem;
  }
  .form-group {
    margin-bottom: 1.5rem;
  }
  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }
  input, textarea, select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 1rem;
  }
  textarea {
    font-family: monospace;
  }
  button {
    background: var(--text);
    color: white;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
  }
  button:hover {
    opacity: 0.9;
  }
  .image-preview {
    margin-top: 0.5rem;
    max-width: 200px;
  }
  .image-preview img {
    width: 100%;
    border-radius: 6px;
  }
  .status {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: 6px;
  }
  .status.success {
    background: #d4edda;
    color: #155724;
  }
  .status.error {
    background: #f8d7da;
    color: #721c24;
  }
</style>

<div class="admin-form">
  <h1>✍️ New Journal Entry</h1>
  
  <form id="journal-form">
    <div class="form-group">
      <label for="title">Title *</label>
      <input type="text" id="title" required>
    </div>
    
    <div class="form-group">
      <label for="slug">Slug (URL) *</label>
      <input type="text" id="slug" required>
      <small>Will be: journal.allisondollar.com/<strong id="slug-preview">slug-here</strong>/</small>
      <button type="button" id="generate-slug" style="margin-top: 0.5rem; background: var(--gray-dark);">Generate from title</button>
    </div>
    
    <div class="form-group">
      <label for="body">Content (Markdown) *</label>
      <textarea id="body" rows="15" required></textarea>
      <small>Supports **bold**, *italic*, [links](url), and ![alt](image-url)</small>
    </div>
    
    <div class="form-group">
      <label for="cover_image">Cover Image URL</label>
      <input type="url" id="cover_image" placeholder="https://...">
      <div id="cover-preview" class="image-preview"></div>
      <button type="button" id="upload-image-btn" style="margin-top: 0.5rem;">📤 Upload New Image</button>
      <input type="file" id="image-upload" accept="image/*" style="display: none;">
    </div>
    
    <div class="form-group">
      <label for="date">Date</label>
      <input type="date" id="date">
    </div>
    
    <div class="form-group">
      <label for="tags">Tags (comma separated)</label>
      <input type="text" id="tags" placeholder="coloring-book, app, video">
    </div>
    
    <div class="form-group">
      <label>
        <input type="checkbox" id="published" checked> Publish immediately
      </label>
    </div>
    
    <button type="submit">📌 Publish Entry</button>
    <div id="status" class="status" style="display: none;"></div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
// Slug generator
document.getElementById('generate-slug').onclick = () => {
  const title = document.getElementById('title').value;
  const slug = title.toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  document.getElementById('slug').value = slug;
  document.getElementById('slug-preview').textContent = slug + '/';
};

// Live slug preview
document.getElementById('slug').oninput = () => {
  const slug = document.getElementById('slug').value;
  document.getElementById('slug-preview').textContent = (slug || 'slug-here') + '/';
};

// Cover image preview
document.getElementById('cover_image').oninput = () => {
  const url = document.getElementById('cover_image').value;
  const preview = document.getElementById('cover-preview');
  if (url) {
    preview.innerHTML = `<img src="${url}" alt="preview">`;
  } else {
    preview.innerHTML = '';
  }
};

// Image upload
const uploadBtn = document.getElementById('upload-image-btn');
const fileInput = document.getElementById('image-upload');

uploadBtn.onclick = () => fileInput.click();

fileInput.onchange = async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  
  uploadBtn.textContent = '⏳ Uploading...';
  uploadBtn.disabled = true;
  
  const formData = new FormData();
  formData.append('file', file);
  
  try {
    const response = await fetch('https://allisondollar.com/.netlify/functions/upload-image', {
      method: 'POST',
      body: formData
    });
    const data = await response.json();
    
    if (data.url) {
      document.getElementById('cover_image').value = data.url;
      document.getElementById('cover-preview').innerHTML = `<img src="${data.url}" alt="preview">`;
      uploadBtn.textContent = '✅ Uploaded!';
      setTimeout(() => { uploadBtn.textContent = '📤 Upload New Image'; }, 2000);
    } else {
      throw new Error(data.error || 'Upload failed');
    }
  } catch (err) {
    uploadBtn.textContent = '❌ Failed, try again';
    console.error(err);
  } finally {
    uploadBtn.disabled = false;
    fileInput.value = '';
  }
};

// Form submission
document.getElementById('journal-form').onsubmit = async (e) => {
  e.preventDefault();
  
  const statusDiv = document.getElementById('status');
  statusDiv.style.display = 'block';
  statusDiv.className = 'status';
  statusDiv.textContent = 'Saving...';
  
  const entry = {
    title: document.getElementById('title').value,
    slug: document.getElementById('slug').value,
    body: document.getElementById('body').value,
    cover_image: document.getElementById('cover_image').value || null,
    date: document.getElementById('date').value || new Date().toISOString().split('T')[0],
    tags: document.getElementById('tags').value.split(',').map(t => t.trim()).filter(t => t),
    published: document.getElementById('published').checked
  };
  
  try {
    const response = await fetch('https://allisondollar.com/.netlify/functions/save-journal', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(entry)
    });
    
    const result = await response.json();
    
    if (result.success) {
      statusDiv.className = 'status success';
      statusDiv.innerHTML = `✅ Published! <a href="/journal/${entry.slug}/" target="_blank">View entry</a>`;
      document.getElementById('journal-form').reset();
      document.getElementById('cover-preview').innerHTML = '';
    } else {
      throw new Error(result.error || 'Unknown error');
    }
  } catch (err) {
    statusDiv.className = 'status error';
    statusDiv.textContent = `❌ Error: ${err.message}`;
  }
};
</script>

{% else %}
<div style="max-width: 400px; margin: 4rem auto; text-align: center;">
  <h1>Journal Admin</h1>
  <form onsubmit="event.preventDefault(); window.location.href = '/journal/admin-custom/?secret=' + document.getElementById('secret').value">
    <input type="password" id="secret" placeholder="Enter password" style="width: 100%; padding: 0.75rem; margin-bottom: 1rem;">
    <button type="submit">Login</button>
  </form>
</div>
{% endif %}